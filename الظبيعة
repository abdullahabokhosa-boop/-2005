<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hello World!"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
    <?xml version="1.0" encoding="utf-8"?>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="618dp"
                android:layout_height="235dp"
                app:srcCompat="@drawable/resource__" />

            <TextView
                android:id="@+id/articleTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="رحلة إلى الطبيعة الجميلة"
                android:textSize="27sp"
                android:textStyle="bold"
                android:textColor="#172554"
                android:layout_marginTop="20dp" />

            <TextView
                android:id="@+id/articleAuthor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="بقلم: عبدالله ابوخوصة"
                android:textSize="20dp"
                android:textColor="#64748B"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/articleDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="21 أكتوبر 2026"
                android:textSize="20dp"
                android:textColor="#64748B"
                android:layout_marginTop="6dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E2E8F0"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="18dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="مقدمة المقال"
                android:textSize="25dp"
                android:textStyle="bold"
                android:textColor="#172554" />

            <TextView
                android:id="@+id/articleBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="7dp"
                android:text="تُعد الطبيعة من أجمل النعم التي تحيط بنا، فهي تمنح الإنسان الراحة والهدوء وتجدد الطاقة. إن زيارة الأماكن الطبيعية فرصة رائعة للاسترخاء والاستمتاع بجمال الجبال والبحيرات والمناظر الخلابة.\n\nيمكننا المحافظة على الطبيعة من خلال عدم رمي النفايات، وزراعة الأشجار، والمحافظة على نظافة الأماكن العامة."
                android:textColor="#334155"
                android:textSize="30dp" />

        </LinearLayout>

    </ScrollView>
    />

</androidx.constraintlayout.widget.ConstraintLayout>
