<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hello World!"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"

    <?xml version="1.0" encoding="utf-8"?>
    <GridLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:rowCount="2"
        android:columnCount="2"
        android:padding="8dp"
        android:useDefaultMargins="true">

        <TextView
            android:id="@+id/section1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="0"
            android:layout_column="0"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:background="#BBDEFB"
            android:gravity="center"
            android:text=" انا اسمي عبدالله وليد ابراهيم ابوخوصة "
            android:textColor="#000000"
            android:textSize="20sp"/>

        <TextView
            android:id="@+id/section2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="0"
            android:layout_column="1"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:background="#F8BBD0"
            android:gravity="center"
            android:text=" اعيش في فلسطين من غزة "
            android:textColor="#000000"
            android:textSize="20sp"/>

        <TextView
            android:id="@+id/section3"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="1"
            android:layout_column="0"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:background="#C8E6C9"
            android:gravity="center"
            android:text="ادرس في جامعة الاقصى في كلية الحاسبات ونكنولوجيا المعلومات تخصص وسائط متعددة"
            android:textColor="#000000"
            android:textSize="20sp"/>

        <TextView
            android:id="@+id/section4"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="1"
            android:layout_column="1"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:background="#FFECB3"
            android:gravity="center"
            android:text="هوايتي كرة القدم والعب حاليا في نادي اهلي غزة "
            android:textColor="#000000"
            android:textSize="20sp"

            import android.app.Activity;
        import android.os.Bundle;

        public class MainActivity extends Activity {

        @Override
        protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_main);
        }
        }


            />

        </GridLayout>
        />

    </GridLayout>
    />

</androidx.constraintlayout.widget.ConstraintLayout>
